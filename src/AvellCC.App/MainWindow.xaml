<Window x:Class="AvellCC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AvellCC.App.Localization"
        xmlns:local="clr-namespace:AvellCC.App"
        Title="AvellCC" Icon="/Assets/AvellCC.ico" Width="1120" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="RowBackground" Value="#2A2E36"/>
            <Setter Property="AlternatingRowBackground" Value="#252830"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Height" Value="200"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E323B"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E323B"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="20,12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="AvellCC" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MachineText" Style="{StaticResource Caption}" Text="{l:Tr header.connecting}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="—" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warning banner (service unavailable, emergency, vendor app running...) -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource Warn}" Padding="20,8">
            <TextBlock x:Name="BannerText" Foreground="#16181D" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" Background="{StaticResource Bg}" BorderThickness="0">

            <!-- ============ DASHBOARD ============ -->
            <TabItem Header="{l:Tr tab.dashboard}" Tag="dashboard">
                <local:DashboardPanel x:Name="Dashboard"/>
            </TabItem>

            <!-- ============ FANS ============ -->
            <TabItem Header="{l:Tr tab.fans}" Tag="fans">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr fans.mode}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="FirmwareRadio" Content="{l:Tr fans.firmware}" GroupName="FanMode" Click="ModeRadio_Click"/>
                                        <RadioButton x:Name="CurveRadio" Content="{l:Tr fans.curve}" GroupName="FanMode" Click="ModeRadio_Click"/>
                                    </StackPanel>
                                    <!-- Explains the selected option (firmware vs. curve) -->
                                    <Border Background="#191B21" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="ModeHelpFirmware" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr fans.help.firmware}"/>
                                            <TextBlock x:Name="ModeHelpCurve" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{l:Tr fans.help.curve}" Visibility="Collapsed"/>
                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Text="{l:Tr fans.help.apply}"/>
                                        </StackPanel>
                                    </Border>
                                    <ComboBox x:Name="CurveCombo" DisplayMemberPath="Name" Margin="0,0,0,8" SelectionChanged="CurveCombo_SelectionChanged"/>
                                    <Button Content="{l:Tr fans.apply}" HorizontalAlignment="Left" Click="ApplyMode_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr fans.edit}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Content="{l:Tr fans.name}"/>
                                        <TextBox x:Name="NameBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Label Grid.Column="2" Content="{l:Tr fans.hysteresis}"/>
                                        <TextBox x:Name="HysteresisBox" Grid.Column="3" VerticalContentAlignment="Center" Text="4"/>
                                    </Grid>
                                    <CheckBox x:Name="SharedCheck" IsChecked="True" Margin="0,0,0,8" Click="Editor_Changed">
                                        <TextBlock TextWrapping="Wrap" Text="{l:Tr fans.shared}"/>
                                    </CheckBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr fans.cpuPoints}"/>
                                            <DataGrid x:Name="CpuGrid" CellEditEnding="Grid_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="°C" Binding="{Binding Temp}" Width="*"/>
                                                    <DataGridTextColumn Header="%" Binding="{Binding Duty}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="{l:Tr fans.addPoint}" Style="{StaticResource Secondary}" Margin="0,6,0,0" Click="AddCpuPoint_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Caption}" Text="{l:Tr fans.gpuPoints}"/>
                                            <DataGrid x:Name="GpuGrid" CellEditEnding="Grid_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="°C" Binding="{Binding Temp}" Width="*"/>
                                                    <DataGridTextColumn Header="%" Binding="{Binding Duty}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="{l:Tr fans.addPoint}" Style="{StaticResource Secondary}" Margin="0,6,0,0" Click="AddGpuPoint_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8" Text="{l:Tr fans.rules}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Tr fans.save}" Click="SaveCurve_Click"/>
                                        <Button Content="{l:Tr fans.discard}" Style="{StaticResource Secondary}" Click="ReloadCurve_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Width="14" Height="3" Fill="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU" Margin="0,0,16,0"/>
                                <Rectangle Width="14" Height="3" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GPU" Margin="0,0,16,0"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{l:Tr fans.legend}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ KEYBOARD ============ -->
            <TabItem Header="{l:Tr tab.keyboard}" Tag="keyboard">
                <StackPanel Margin="8" MaxWidth="640" HorizontalAlignment="Left">
                    <!-- Named presets: pick one to apply it, or type a name and save the settings below -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr kb.profiles}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="KbProfileCombo" IsEditable="True" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                          SelectionChanged="KbProfile_SelectionChanged"/>
                                <Button Grid.Column="1" Content="{l:Tr kb.profileSave}" Click="SaveKbProfile_Click"/>
                                <Button Grid.Column="2" Content="{l:Tr kb.profileDelete}" Style="{StaticResource Secondary}" Margin="0" Click="DeleteKbProfile_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{l:Tr kb.profilesHelp}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr kb.title}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Content="{l:Tr kb.mode}"/>
                                <ComboBox x:Name="KbModeCombo" Grid.Column="1" Margin="0,0,0,10" SelectionChanged="KbMode_SelectionChanged">
                                    <ComboBoxItem Content="{l:Tr kb.mode.static}" Tag="static"/>
                                    <ComboBoxItem Content="{l:Tr kb.mode.zones}" Tag="zones"/>
                                    <ComboBoxItem Content="{l:Tr kb.mode.effect}" Tag="effect"/>
                                    <ComboBoxItem Content="{l:Tr kb.mode.off}" Tag="off"/>
                                </ComboBox>

                                <Label Grid.Row="1" Content="{l:Tr kb.colors}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="Zone1Button" Width="56" Height="32" Click="Zone_Click" Tag="0"/>
                                    <Button x:Name="Zone2Button" Width="56" Height="32" Click="Zone_Click" Tag="1"/>
                                    <Button x:Name="Zone3Button" Width="56" Height="32" Click="Zone_Click" Tag="2"/>
                                    <Button x:Name="Zone4Button" Width="56" Height="32" Click="Zone_Click" Tag="3"/>
                                </StackPanel>

                                <Label Grid.Row="2" Content="{l:Tr kb.brightness}"/>
                                <Slider x:Name="KbBrightness" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="3" Margin="0,0,0,10"/>

                                <Label Grid.Row="3" Content="{l:Tr kb.effect}"/>
                                <ComboBox x:Name="KbEffectCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                                <Label Grid.Row="4" Content="{l:Tr kb.speed}"/>
                                <Slider x:Name="KbSpeed" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="2" Margin="0,0,0,10"/>

                                <Label Grid.Row="5" Content="{l:Tr kb.direction}"/>
                                <ComboBox x:Name="KbDirectionCombo" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                                    <ComboBoxItem Content="{l:Tr kb.dir.ltr}" Tag="LeftToRight"/>
                                    <ComboBoxItem Content="{l:Tr kb.dir.rtl}" Tag="RightToLeft"/>
                                    <ComboBoxItem Content="{l:Tr kb.dir.btt}" Tag="BottomToTop"/>
                                    <ComboBoxItem Content="{l:Tr kb.dir.ttb}" Tag="TopToBottom"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="KbHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="{l:Tr kb.apply}" HorizontalAlignment="Left" Click="ApplyKeyboard_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ SETTINGS ============ -->
            <TabItem Header="{l:Tr tab.settings}" Tag="settings">
                <StackPanel Margin="8" MaxWidth="640" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr settings.language}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LanguageCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{l:Tr settings.languageHelp}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheck" Content="{l:Tr settings.startup}" Click="StartupCheck_Click"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,4,0,0" Text="{l:Tr settings.startupHelp}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="ModeButtonCheck" Content="{l:Tr settings.modeButton}" Click="ModeButtonCheck_Click"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,4,0,0" Text="{l:Tr settings.modeButtonHelp}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr settings.about}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
