<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AvellCC</AssemblyName>
    <RootNamespace>AvellCC.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.6.0</Version>
    <!-- Generated by AppIcon.ExportIco (AvellCC.exe with the export-icon option); edit the drawing in AppIcon.cs, not the file. -->
    <ApplicationIcon>Assets\AvellCC.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AvellCC.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms only for NotifyIcon and ColorDialog: no global usings, to avoid clashing with WPF types -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AvellCC.Ipc\AvellCC.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One JSON file per UI language, copied next to the exe (users can add languages without rebuilding). -->
    <None Update="Languages\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Languages\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
