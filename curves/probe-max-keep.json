// PROBE: 100 % from 40 °C. If the EC follows the 0xF00 table, fans go to maximum even at idle. Ignored on the A65 LIV.
// "keep": only sets 0x7A5 bit 3 and leaves 0x751 alone.
{
  "name": "probe-max-keep",
  "hysteresis": 4,
  "ecMode": "keep",
  "cpu": [ { "temp": 20, "duty": 70 }, { "temp": 40, "duty": 100 } ],
  "gpu": [ { "temp": 20, "duty": 70 }, { "temp": 40, "duty": 100 } ]
}
