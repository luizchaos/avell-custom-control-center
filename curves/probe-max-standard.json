// PROBE: 100 % from 40 °C, with 0x751 = 0xA0 (vendor Standard mode). Ignored on the A65 LIV.
{
  "name": "probe-max-standard",
  "hysteresis": 4,
  "ecMode": "standard",
  "cpu": [ { "temp": 20, "duty": 70 }, { "temp": 40, "duty": 100 } ],
  "gpu": [ { "temp": 20, "duty": 70 }, { "temp": 40, "duty": 100 } ]
}
