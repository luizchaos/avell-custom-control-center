// Everyday curve (direct control). Quiet at idle (~25–30 %, like the firmware), strong under load.
// Reference: the firmware reaches ~77 % (≈ 5100 RPM) with the CPU at 84 °C; this one reaches 100 % at 85 °C.
{
  "name": "balanced",
  "hysteresis": 4,
  "shared": true,
  "cpu": [
    { "temp": 45, "duty": 25 },
    { "temp": 55, "duty": 32 },
    { "temp": 65, "duty": 45 },
    { "temp": 75, "duty": 70 },
    { "temp": 85, "duty": 100 }
  ],
  "gpu": [
    { "temp": 45, "duty": 25 },
    { "temp": 55, "duty": 32 },
    { "temp": 65, "duty": 45 },
    { "temp": 72, "duty": 70 },
    { "temp": 82, "duty": 100 }
  ]
}
